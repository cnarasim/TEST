# Starter secrets file for Hermes Agent.
#
# Normally the setup wizard (README step 4) fills these in for you.
# To set them by hand, edit /srv/hermes/data/.env (the container creates it
# on first start) and set the values below. Edit the file; don't overwrite
# it, because it contains other defaults. Then run: sudo docker compose restart
# NEVER commit the filled-in file.
#
# The upstream .env.example lists every supported variable:
# https://github.com/NousResearch/hermes-agent/blob/main/.env.example

# ---- LLM provider: pick ONE --------------------------------------------
# Cheapest: OpenAI gpt-6-luna. After setting the key, select the model with:
#   sudo docker exec hermes hermes config set model.provider openai-api
#   sudo docker exec hermes hermes config set model.default gpt-6-luna
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# (Nous Portal uses OAuth instead of a key: docker exec -it hermes hermes setup --portal)

# ---- Messaging gateway: Telegram is the quickest -----------------------
# 1. Message @BotFather in Telegram, send /newbot, and copy the token.
# 2. Message @userinfobot to get your numeric user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=            # your numeric ID; comma-separate several
# TELEGRAM_HOME_CHANNEL=           # chat ID for scheduled-task output

# ---- Slack (alternative) ------------------------------------------------
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_USERS=

# Keep this false. With no allowlist, the gateway answers no one.
GATEWAY_ALLOW_ALL_USERS=false
